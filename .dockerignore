# Keeps the Docker build context (and the image COPY) to what the Tauri
# Windows/Linux cross-compile actually needs -- src-tauri/, src/,
# transcriber.py and friends. Everything below is either huge (.venv),
# host build output not needed inside the container, or unrelated tooling.
.git/
.venv/
__pycache__/
build/
dist/
src-tauri/target/
.claude/
.github/
.impeccable/
.opencode/
openspec/
