{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcriber",
  "version": "0.1.0",
  "identifier": "com.transcriber.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Transcriber",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Offline audio and video transcription",
    "longDescription": "Transcribe meetings, calls and recordings on your own machine. Transcribes video and audio files to TXT, SRT or VTT, and live sessions from system audio and the microphone at once. The speech model ships with the application, so nothing is uploaded and the first transcription works with the network off.",
    "targets": [
      "appimage",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/transcriber-sidecar"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ],
        "files": {
          "/etc/apt/sources.list.d/transcriber.list": "../packaging/transcriber.list",
          "/usr/share/keyrings/transcriber-archive-keyring.asc": "../packaging/transcriber-repo-key.asc"
        },
        "desktopTemplate": "../packaging/transcriber.desktop"
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libasound.so.2()(64bit)"
        ],
        "compression": {
          "type": "none"
        },
        "files": {
          "/etc/yum.repos.d/transcriber.repo": "../packaging/transcriber.repo",
          "/etc/pki/rpm-gpg/RPM-GPG-KEY-transcriber": "../packaging/transcriber-repo-key.asc"
        },
        "desktopTemplate": "../packaging/transcriber.desktop"
      }
    },
    "resources": {
      "resources/model": "resources/model",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../SOURCE-PROVENANCE.txt": "SOURCE-PROVENANCE.txt"
    }
  }
}
