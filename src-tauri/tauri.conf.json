{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcriber",
  "version": "0.1.0",
  "identifier": "com.transcriber.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Transcriber",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "app"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": [
      "binaries/transcriber-sidecar"
    ],
    "linux": {
      "rpm": {
        "depends": ["libwebkit2gtk-4.1.so.0()(64bit)", "libgtk-3.so.0()(64bit)"]
      }
    },
    "resources": {
      "resources/model": "resources/model",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../SOURCE-PROVENANCE.txt": "SOURCE-PROVENANCE.txt"
    }
  }
}
