# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv-linux/
.venv
.venv311/

# Environment variables
.env
.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary audio files
*.wav
*.mp3
*.flac
extracted_audio_*.wav

# Output transcripts (uncomment if you don't want to track them)
*_transcript.txt
*.srt
*.vtt
*.txt

# ...but some .txt files are project files, not transcripts, and must be tracked.
# The dependency manifests only survive today because they were committed before
# the *.txt rule existed (gitignore does not apply to already-tracked files) --
# a new one would silently fail to commit. Listed by exact name on purpose: a
# glob like requirements*.txt would also un-ignore a real transcript, since the
# launchers accept a name prefix (`win-start-transcription.bat requirements-review`
# produces requirements-review_<timestamp>.txt). Add a line when adding a manifest.
!requirements.txt
!requirements-linux.txt
!requirements-macos.txt

# The licence notices ship inside every artifact to satisfy the bundled
# components' licence terms, and build_portable.py refuses to assemble an
# artifact without them.
!THIRD-PARTY-LICENSES.txt
!SOURCE-PROVENANCE.txt

# Model cache (Whisper models are downloaded to cache)
.cache/
models/

# Logs
*.log

# PyInstaller sidecar build output (openspec/changes/add-tauri-gui)
/build/
/dist/

# Staged installer resources (the ~145MB model) -- resolved relative to src-tauri/.
# The model's own licence notice is the one thing here that must be tracked, so
# this excludes the contents rather than the directory: git cannot re-include a
# file whose parent directory is itself excluded.
src-tauri/resources/**
!src-tauri/resources/model/
!src-tauri/resources/model/LICENSE.txt

# Tauri/Rust build output
src-tauri/target/

# Staged sidecar binary (copied from dist/ into Tauri's externalBin location)
src-tauri/binaries/

# SwiftPM build output and the compiled macOS audio-tap helper. Both are
# produced by macos/audiotap-helper/build.sh on a Mac; .build/ alone is ~121MB
# of module caches and debug symbols.
macos/audiotap-helper/.build/
macos/audiotap-helper/audiotap-helper
